# ---------------------------------------------------------------------------
# Copy to `.env` (repo root). NEVER commit `.env`. All secrets live ONLY here
# (or in your hosting platform's secret store) — never in the database.
# ---------------------------------------------------------------------------

# Database. Postgres for production / Docker Compose:
DATABASE_URL="postgresql://aiv:aiv@localhost:5432/aiv"
# SQLite fallback for local dev without Docker (use an ABSOLUTE path):
# DATABASE_URL="file:/absolute/path/to/ai-visibility/packages/db/prisma/dev.db"

# NextAuth. Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me"

# Optional: Microsoft Entra ID single sign-on for THIS app (users must also exist in AppUser).
# AZURE_AD_CLIENT_ID=""
# AZURE_AD_CLIENT_SECRET=""
# AZURE_AD_TENANT_ID=""

# Password for the seeded demo users (it@ / exec@ / manager@demo.local).
DEMO_PASSWORD="demo1234"

# Branding overrides (optional; defaults live in packages/core/src/brand.ts).
# NEXT_PUBLIC_PRODUCT_NAME="Lumen AI Insight"
# NEXT_PUBLIC_VENDOR_NAME="Your IT Partner"

# Microsoft Graph connector (pilot client's Entra app registration — see docs/PILOT_SETUP.md).
# GRAPH_TENANT_ID=""
# GRAPH_CLIENT_ID=""
# GRAPH_CLIENT_SECRET=""

# Worker schedule
SYNC_INTERVAL_MINUTES=360

# ---------------------------------------------------------------------------
# Content scanning runs in the worker inside YOUR environment. Scan settings
# (size limits, file types, snippets) are per tenant in Settings → Content
# scanning. Files are read in memory and never stored.
# ---------------------------------------------------------------------------

# Optional LLM classification / policy drafting. OFF by default. Only endpoints
# YOU control are accepted: your Azure OpenAI resource, or a model server on your
# network (Ollama, vLLM, LM Studio). Public AI APIs (api.openai.com etc.) are refused.
LLM_PROVIDER="none"            # none | azure-openai | openai-compatible
# AZURE_OPENAI_ENDPOINT="https://<your-resource>.openai.azure.com"
# AZURE_OPENAI_DEPLOYMENT="gpt-4o-mini"
# AZURE_OPENAI_API_KEY=""
# AZURE_OPENAI_API_VERSION="2024-10-21"
# LLM_BASE_URL="http://ollama:11434/v1"
# LLM_MODEL="llama3.1:8b"
# LLM_API_KEY=""
# Extra hosts inside your network that are allowed (comma-separated), e.g. a private APIM gateway.
# LLM_ALLOWED_HOSTS="aoai-gw.contoso.internal"

# Vendor telemetry: OFF by default. If you opt in, only anonymised, bucketed
# counts are sent (see docs/SECURITY.md → Telemetry) and each send is audit-logged.
TELEMETRY_ENABLED="false"
# Third-party tool telemetry is also off (Next.js CLI, Prisma update checks):
NEXT_TELEMETRY_DISABLED="1"
CHECKPOINT_DISABLE="1"
# TELEMETRY_ENDPOINT="https://telemetry.example.com/v1/lumen"
# TELEMETRY_SALT="<random string, keeps the install id unlinkable>"

# Docker Compose: interface the web port binds to (default localhost only).
# WEB_BIND="0.0.0.0"
