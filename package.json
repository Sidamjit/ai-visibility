{
  "name": "ai-visibility",
  "private": true,
  "version": "0.1.0",
  "description": "AI visibility & value platform: exposure, risk, spend and value analytics for an organisation's AI estate.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "npm run dev -w @aiv/web",
    "build": "npm run db:generate && npm run build -w @aiv/web",
    "start": "npm run start -w @aiv/web",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run db:generate && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "npm run generate -w @aiv/db",
    "db:push": "npm run push -w @aiv/db",
    "db:seed": "npm run seed -w @aiv/worker",
    "worker:sync": "npm run sync -w @aiv/worker",
    "screenshots": "node scripts/screenshots.mjs",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build",
    "worker": "npm run cli -w @aiv/worker --"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@next/eslint-plugin-next": "15.5.29",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "playwright-core": "^1.55.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  },
  "overrides": {
    "postcss": "^8.5.33",
    "deepmerge-ts": "^8.0.2",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
