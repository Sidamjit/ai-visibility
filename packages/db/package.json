{
  "name": "@aiv/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, client singleton and persistence helpers (Postgres in production, SQLite fallback for local dev).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "node scripts/prisma.mjs generate",
    "push": "node scripts/prisma.mjs db push --skip-generate",
    "studio": "node scripts/prisma.mjs studio",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aiv/core": "0.1.0",
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
