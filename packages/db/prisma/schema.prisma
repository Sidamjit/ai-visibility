// Prisma schema — single source of truth for the database.
//
// PORTABILITY RULES (so the same schema runs on Postgres and SQLite):
//   - no `enum` (use String + zod validation in code; allowed values documented inline)
//   - no scalar lists (String[]) — use Json
//   - no native type attributes (@db.*)
// The provider below is rewritten by scripts/prisma.mjs based on DATABASE_URL.
//
// MULTI-TENANCY: every business table carries `tenantId`. All queries MUST
// filter by tenantId (see apps/web/lib/data.ts for the pattern).
//
// DATA MINIMISATION: no file contents, prompts or messages are ever stored.
// Content scanning persists only findings: classifier ids, counts, keyed hashes,
// confidence and (optional, redacted, default OFF) short snippets — see ContentScan.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A customer organisation.
model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  /// Editable value/cost assumptions (see @aiv/core assumptions.ts). Null = defaults.
  assumptions Json?
  /// Client data-classification / handling policy (@aiv/policy PolicySchema). Null = NZ sample.
  policy      Json?
  policyUpdatedAt DateTime?
  policyUpdatedBy String?
  /// Content-scan settings (@aiv/core ScanSettingsSchema). Null = defaults.
  scanSettings Json?
  /// Master switch for the vendor-support role. Off by default; grants also need an expiry.
  vendorAccessEnabled Boolean @default(false)
  createdAt   DateTime @default(now())

  users      AppUser[]
  connectors ConnectorInstance[]
  runs       AnalysisRun[]
}

/// A person who signs in to THIS app (not a person in the analysed tenant).
model AppUser {
  id           String   @id @default(cuid())
  tenantId     String
  email        String   @unique
  name         String
  /// bcrypt hash; null for SSO-only users.
  passwordHash String?
  /// 'IT' | 'EXECUTIVE' | 'MANAGER' | 'VENDOR_SUPPORT'
  /// VENDOR_SUPPORT users can only sign in while an unexpired, unrevoked
  /// VendorAccessGrant exists AND Tenant.vendorAccessEnabled is true.
  role         String
  /// For MANAGER: department they manage (filters the manager dashboard).
  department   String?
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// A configured connector for a tenant. Secrets are NEVER stored here (env only).
model ConnectorInstance {
  id           String    @id @default(cuid())
  tenantId     String
  /// Connector id from @aiv/connectors registry, e.g. 'microsoft-graph', 'demo'.
  connectorId  String
  displayName  String
  /// Non-secret config validated by the connector's zod schema.
  config       Json
  /// Opaque incremental-sync cursor owned by the connector.
  cursor       Json?
  /// 'idle' | 'running' | 'ok' | 'error'
  status       String    @default("idle")
  lastSyncAt   DateTime?
  lastError    String?
  lastStats    Json?
  lastWarnings Json?
  createdAt    DateTime  @default(now())
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  syncRuns     SyncRun[]

  @@index([tenantId])
}

model SyncRun {
  id                  String            @id @default(cuid())
  tenantId            String
  connectorInstanceId String
  startedAt           DateTime          @default(now())
  finishedAt          DateTime?
  /// 'running' | 'ok' | 'error'
  status              String
  fullSync            Boolean           @default(false)
  stats               Json?
  warnings            Json?
  error               String?
  connector           ConnectorInstance @relation(fields: [connectorInstanceId], references: [id], onDelete: Cascade)

  @@index([tenantId, startedAt])
}

// ---------- Normalized entities (mirror @aiv/core model.ts) ----------

model Department {
  id                  String @id @default(cuid())
  tenantId            String
  connectorInstanceId String
  externalId          String
  name                String

  @@unique([tenantId, connectorInstanceId, externalId])
}

model Identity {
  id                  String    @id @default(cuid())
  tenantId            String
  connectorInstanceId String
  externalId          String
  displayName         String
  email               String?
  departmentName      String?
  jobTitle            String?
  isGuest             Boolean
  accountEnabled      Boolean
  lastSignInAt        DateTime?

  @@unique([tenantId, connectorInstanceId, externalId])
  @@index([tenantId, departmentName])
}

model AIAsset {
  id                  String  @id @default(cuid())
  tenantId            String
  connectorInstanceId String
  externalId          String
  name                String
  vendor              String
  /// 'copilot' | 'chat-assistant' | 'agent' | 'custom-model' | 'lms-ai' | 'other'
  kind                String
  groundedOnOrgData   Boolean

  @@unique([tenantId, connectorInstanceId, externalId])
}

model Licence {
  id                  String    @id @default(cuid())
  tenantId            String
  connectorInstanceId String
  identityExternalId  String
  assetExternalId     String
  skuId               String
  skuName             String
  assignedAt          DateTime?

  @@index([tenantId, identityExternalId])
}

model UsageSummary {
  id                  String    @id @default(cuid())
  tenantId            String
  connectorInstanceId String
  identityExternalId  String
  assetExternalId     String
  periodStart         DateTime
  periodEnd           DateTime
  lastActivityAt      DateTime?
  activeDays          Int?
  /// { [feature]: ISO date | null }
  featureLastActivity Json

  @@index([tenantId, identityExternalId])
}

model ContentLocation {
  id                  String    @id @default(cuid())
  tenantId            String
  connectorInstanceId String
  externalId          String
  parentExternalId    String?
  /// 'site' | 'library' | 'folder' | 'file' | 'onedrive' | 'team'
  kind                String
  name                String
  webUrl              String?
  siteExternalId      String?
  ownerDepartment     String?
  /// 'public' | 'private' | 'unknown'
  visibility          String
  memberCount         Int?
  guestMemberCount    Int?
  itemCount           Int?
  lastModifiedAt      DateTime?
  sensitivityLabelId  String?
  hasUniquePermissions Boolean
  likelySensitive     Boolean
  /// string[]
  sensitivityReasons  Json

  @@unique([tenantId, connectorInstanceId, externalId])
  @@index([tenantId, siteExternalId])
}

model SharingGrant {
  id                     String    @id @default(cuid())
  tenantId               String
  connectorInstanceId    String
  externalId             String
  locationExternalId     String
  /// 'anyone' | 'organization' | 'specific-people' | 'direct' | 'external-guest'
  scope                  String
  /// string[]
  roles                  Json
  /// string[]
  grantedToExternalIds   Json
  externalPrincipalCount Int
  createdAt              DateTime?
  expiresAt              DateTime?
  inherited              Boolean

  @@unique([tenantId, connectorInstanceId, externalId])
  @@index([tenantId, locationExternalId])
}

model SensitivityLabel {
  id                  String  @id @default(cuid())
  tenantId            String
  connectorInstanceId String
  externalId          String
  name                String
  priority            Int
  isSensitive         Boolean

  @@unique([tenantId, connectorInstanceId, externalId])
}

model CostItem {
  id                  String @id @default(cuid())
  tenantId            String
  connectorInstanceId String
  externalId          String
  assetExternalId     String
  /// 'licence' | 'consumption' | 'platform' | 'services'
  category            String
  description         String
  monthlyAmount       Float
  currency            String

  @@unique([tenantId, connectorInstanceId, externalId])
}

/// Result of reading ONE file's content. The content itself is never stored:
/// only which classifiers matched, how often, keyed hashes for de-duplication,
/// and (if snippetMode != 'off') short REDACTED context snippets inside `hits`.
model ContentScan {
  id                  String   @id @default(cuid())
  tenantId            String
  connectorInstanceId String
  locationExternalId  String
  siteExternalId      String?
  extension           String
  /// Float (not Int) so >2 GB files are representable on every provider.
  sizeBytes           Float
  /// SHA-256 of the bytes (detects duplicates/changes; not reversible).
  contentSha256       String?
  /// Source change token (Graph cTag) used to skip unchanged files.
  sourceVersion       String?
  scannedAt           DateTime
  /// 'scanned' | 'skipped' | 'failed'
  status              String
  statusReason        String?
  textChars           Int
  /// Sum of hit counts (fast filtering).
  hitCount            Int
  /// ClassifierHit[] (@aiv/core content.ts)
  hits                Json
  /// LlmAssessment | null — only when the client enabled their own LLM endpoint.
  llm                 Json?

  @@unique([tenantId, connectorInstanceId, locationExternalId])
  @@index([tenantId, hitCount])
}

/// A draft policy produced from an uploaded policy document, awaiting human review.
/// The uploaded document itself is NOT stored (only its hash and name).
model PolicyDraft {
  id           String    @id @default(cuid())
  tenantId     String
  createdAt    DateTime  @default(now())
  createdBy    String
  sourceName   String
  sourceSha256 String
  /// 'heuristic' | 'llm'
  method       String
  /// string[] — reviewer notes produced by the extractor.
  notes        Json
  /// Draft Policy (validated) as JSON.
  draft        Json
  /// 'pending' | 'accepted' | 'rejected'
  status       String    @default("pending")
  reviewedBy   String?
  reviewedAt   DateTime?

  @@index([tenantId, createdAt])
}

/// Append-only audit of who did/viewed what in THIS app. Never contains file content.
model AuditEvent {
  id         String   @id @default(cuid())
  tenantId   String
  at         DateTime @default(now())
  /// App user email (or 'system' / 'worker').
  actor      String
  actorRole  String?
  /// e.g. 'auth.login', 'page.view', 'export.csv', 'policy.update', 'vendor.grant'
  action     String
  /// Page path, export name, setting key …
  target     String?
  detail     Json?

  @@index([tenantId, at])
  @@index([tenantId, actor])
}

/// Time-boxed support access granted BY THE CLIENT to the app vendor.
model VendorAccessGrant {
  id         String    @id @default(cuid())
  tenantId   String
  /// The VENDOR_SUPPORT AppUser this grant enables.
  appUserId  String
  email      String
  /// 'diagnostics' (support page only) | 'read-only' (dashboards incl. findings)
  scope      String
  reason     String
  grantedBy  String
  grantedAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  revokedBy  String?

  @@index([tenantId, expiresAt])
  @@index([appUserId])
}

// ---------- Analysis output ----------

/// One execution of the analysis engine. Dashboards read the latest run; trends read all.
model AnalysisRun {
  id          String           @id @default(cuid())
  tenantId    String
  createdAt   DateTime         @default(now())
  asOf        DateTime
  riskScore   Int
  valueScore  Int
  scores      Json
  metrics     Json
  siteScores  Json
  departments Json
  assumptions Json
  /// ContentMetrics (@aiv/analysis) — null when no policy/scans.
  content     Json?
  /// ClassifiedFileView[] (capped) — what was found where; no content.
  contentFiles Json?
  /// True for back-filled demo history (trend charts); never for real tenants.
  simulated   Boolean          @default(false)
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  findings    Finding[]
  recommendations Recommendation[]
  valueMetrics ValueMetric[]

  @@index([tenantId, createdAt])
}

model Finding {
  id             String          @id @default(cuid())
  runId          String
  tenantId       String
  /// Stable across runs: `${ruleId}:${key}`.
  findingKey     String
  ruleId         String
  ruleName       String
  /// 'risk' | 'opportunity'
  kind           String
  category       String
  /// 'critical' | 'high' | 'medium' | 'low' | 'info'
  severity       String
  title          String
  summary        String
  evidence       Json
  siteExternalId String?
  departmentName String?
  affectedCount  Int
  monthlyImpact  Float?
  run            AnalysisRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  recommendation Recommendation?

  @@index([tenantId, runId])
  @@index([tenantId, findingKey])
}

model Recommendation {
  id        String      @id @default(cuid())
  runId     String
  tenantId  String
  findingId String      @unique
  title     String
  /// string[]
  steps     Json
  /// Role[]
  audience  Json
  effort    String
  impact    String
  run       AnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  finding   Finding     @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([tenantId, runId])
}

/// Headline value metrics with the assumptions that produced them (for audit/report).
model ValueMetric {
  id             String      @id @default(cuid())
  runId          String
  tenantId       String
  key            String
  label          String
  value          Float
  unit           String
  /// keys of Assumptions used
  assumptionKeys Json
  run            AnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([tenantId, runId])
}

/// Remediation checklist progress. Keyed by findingKey so ticks survive re-analysis.
model RemediationTask {
  id         String    @id @default(cuid())
  tenantId   String
  findingKey String
  stepIndex  Int
  done       Boolean   @default(false)
  doneBy     String?
  doneAt     DateTime?

  @@unique([tenantId, findingKey, stepIndex])
}
